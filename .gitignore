scripts/seo/gsc_token.json
scripts/seo/gsc_optimization_candidates.json
scripts/seo/optimization_suggestions.json
scripts/seo/optimization_suggestions_review.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# auto-fix backups from fix-broken-tools.mjs
*.broken.tsx
scripts/seo/gsc_credentials.json
.venv/
*.tsx.bak
