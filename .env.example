# Copy this file to .env.local and fill in your real keys.
# Never commit .env.local to git.

# ── Search API ───────────────────────────────────────────────────────────────
SERPAPI_KEY=

# ── OpenAI (used by ai_generate.py, generate_tool.py) ────────────────────────
OPENAI_API_KEY=
OPENAI_API_KEY_BACKUP=

# ── Anthropic Claude (used by write-tool-guide.py, generate-variants.py, etc) ─
CLAUDE_API_KEY=
CLAUDE_API_KEY_BACKUP=

# ── Google Gemini (optional fallback for content/translation) ──────────────────
GEMINI_API_KEY=

# ── Provider priority: comma-separated list, first available wins ──────────────
# Examples: "claude,openai,gemini" or "openai,gemini,claude"
LLM_PROVIDER_PRIORITY=openai,claude,gemini

# ── Cloudflare Worker proxy for Notion requests (optional) ───────────────────
NEXT_PUBLIC_NOTION_PROXY_URL=
