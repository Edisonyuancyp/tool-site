# Google Search Console API credentials
# Path to the downloaded OAuth 2.0 credentials JSON from Google Cloud Console
GSC_CREDENTIALS_PATH=./gsc_credentials.json

# Google Search Console site property (include trailing slash for domain properties)
GSC_SITE_URL=https://getfastcalc.com/

# AI API keys (choose one or both; Claude is preferred if available)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# AI model to use for analysis. Supported values:
# - claude-3-5-sonnet-20241022
# - claude-3-5-sonnet-20240620
# - gpt-4o
# - gpt-4o-mini
AI_MODEL=gpt-4o

# Optional: how many days of GSC data to fetch (default 7)
GSC_DAYS=7

# Telegram Bot (optional) — for triggering the SEO pipeline from Telegram
# Create a bot via @BotFather and get your chat ID from @userinfobot
TG_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
TG_CHAT_ID=123456789
